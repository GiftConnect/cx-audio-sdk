{
  "expo": {
    "name": "Flappy Blob RN",
    "slug": "flappy-blob-react-native",
    "version": "0.1.3",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.cx.audio.samples.flappyreactnative",
      "supportsTablet": true
    },
    "android": {
      "package": "com.cx.audio.samples.flappyreactnative"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Allow Flappy Blob to use a device advertising identifier to request and measure ads."
        }
      ],
      "./plugins/withCxAudioSdk"
    ]
  }
}
